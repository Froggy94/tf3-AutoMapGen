{
  "$schema": "../../../schemas/graph.schema.json",
  "id": "map",
  "title": "Map Generation",
  "description": "The complete map: heightmap, biomes and rivers (painted ones moved into the valley line); a draft terrain (terrain_core) for the planners - paths, country roads, towns, industries; the terrain settled around towns and industries; the final terrain (terrain_core again) with the terrain under roads and paths and the riverbed groove; all import layers, plans, the map editor's import files, the climate mod and the map's own mods (paths as streets, industry names). The road network between the places is not built here (experimental, graph map_roads).",
  "params": {
    "dem_path": {
      "to": [
        "source_data.dem_path"
      ],
      "description": "GeoTIFF of the elevation model (empty: download)"
    },
    "crop": {
      "to": [
        "source_data.crop"
      ],
      "description": "part of the elevation model (WGS84 degrees)"
    },
    "dem_download": {
      "to": [
        "source_data.dem_download"
      ],
      "description": "without dem_path: the elevation model to download from OpenTopography"
    },
    "game_width_km": {
      "to": [
        "source_data.game_width_km"
      ]
    },
    "game_height_km": {
      "to": [
        "source_data.game_height_km"
      ]
    },
    "scale": {
      "to": [
        "source_data.scale"
      ],
      "description": "scale 1:scale"
    },
    "height_scale": {
      "to": [
        "source_data.height_scale"
      ],
      "description": "heights 1:height_scale; empty = like the distances"
    },
    "rotation_deg": {
      "to": [
        "source_data.rotation_deg"
      ]
    },
    "min_height_m": {
      "to": [
        "terraforming.min_height_m"
      ],
      "description": "lowest land; empty = lowest point"
    },
    "water_sink_m": {
      "to": [
        "terraforming.water_sink_m",
        "final_terrain.water_sink_m"
      ],
      "description": "core of real water this much below the lowest land"
    },
    "max_height_m": {
      "to": [
        "final_terrain.max_height_m"
      ],
      "description": "white of the heightmap; empty = highest point"
    },
    "real_water_rivers": {
      "to": [
        "terraforming.real_water_rivers"
      ],
      "description": "which waterways may be real water: all (below the limit) or only navigable ones (CEMT class, navigable_names, unnamed canals attached to them)"
    },
    "navigable_names": {
      "to": [
        "terraforming.navigable_names"
      ],
      "description": "waterways whose name starts with one of these count as navigable (case-insensitive)"
    },
    "ramp_length_game_m": {
      "to": [
        "terraforming.ramp_length_game_m",
        "final_terrain.ramp_length_game_m"
      ],
      "description": "ramp of the painted riverbed down to real water over this length (game m); 0 = no ramp"
    },
    "ramp_corridor_game_m": {
      "to": [
        "terraforming.ramp_corridor_game_m",
        "final_terrain.ramp_corridor_game_m"
      ],
      "description": "the terrain beside the ramp follows it this far on each side (game m)"
    },
    "real_water_until_m": {
      "to": [
        "terraforming.real_water_until_m",
        "final_terrain.real_water_until_m"
      ],
      "description": "real (game) water only up to this height a.s.l.; above painted water; empty = 120 m above the lowest land"
    },
    "climate_reference_step_m": {
      "to": [
        "climate.climate_reference_step_m"
      ],
      "description": "the climate mod's reference height = the lowest land rounded to this step (0 = exact)"
    },
    "max_towns": {
      "to": [
        "planning.max_towns"
      ],
      "description": "at most this many towns (0 = from the map area)"
    },
    "ignore_town_size": {
      "to": [
        "planning.ignore_town_size"
      ],
      "description": "ignore the real town size: all towns start at the minimum and count as equal (industries, roads)"
    },
    "industry_density": {
      "to": [
        "planning.industry_density"
      ],
      "description": "industry density: factories per type, raw-material industries and resource areas x this factor"
    },
    "all_cargos": {
      "to": [
        "planning.all_cargos"
      ],
      "description": "all cargos: resources without fitting land get areas anyway (unrealistic); factories without input source are placed anyway"
    },
    "town_min_distance_game_m": {
      "to": [
        "planning.town_min_distance_game_m"
      ],
      "description": "minimum distance between towns"
    },
    "path_forest_gap_game_m": {
      "to": [
        "biome_creation.path_forest_gap_game_m"
      ],
      "description": "gap in the forest along paths"
    },
    "road_forest_gap_game_m": {
      "to": [
        "biome_creation.road_forest_gap_game_m"
      ],
      "description": "gap in the forest along roads"
    },
    "forest_shrink_px": {
      "to": [
        "biome_creation.forest_shrink_px"
      ],
      "description": "shrink the forest along its edge (1 px = 4 game m; 0 = off) against the game's coarse layer reading"
    },
    "biome_limits_m": {
      "to": [
        "terraforming.biome_limits_m"
      ],
      "description": "preset: borders between biome 1|2, 2|3, 3|4 (m)"
    },
    "mountains_from_m": {
      "to": [
        "terraforming.mountains_from_m"
      ],
      "description": "preset: mountain mask from (m)"
    },
    "forest_classes": {
      "to": [
        "terraforming.forest_classes",
        "final_terrain.forest_classes"
      ],
      "description": "preset"
    },
    "meadow_classes": {
      "to": [
        "terraforming.meadow_classes",
        "final_terrain.meadow_classes"
      ],
      "description": "preset"
    },
    "cropland_classes": {
      "to": [
        "terraforming.cropland_classes",
        "final_terrain.cropland_classes"
      ],
      "description": "preset"
    },
    "rock_classes": {
      "to": [
        "terraforming.rock_classes",
        "final_terrain.rock_classes"
      ],
      "description": "preset"
    },
    "crops": {
      "to": [
        "terraforming.crops",
        "final_terrain.crops"
      ],
      "description": "preset: crop types of the fields"
    },
    "industries": {
      "to": [
        "planning.industries",
        "climate.industries",
        "map_mods.industries"
      ],
      "description": "preset: the industry planning of the climate"
    },
    "climate": {
      "to": [
        "climate.climate"
      ],
      "description": "preset: the climate (landscape type) of the climate mod"
    },
    "transition": {
      "to": [
        "climate.transition",
        "biome_creation.transition"
      ],
      "description": "landscape: a second look on part of the map"
    },
    "publishing": {
      "to": [
        "climate.publishing",
        "map_mods.publishing"
      ],
      "description": "names, author and images of the published mods"
    },
    "climate_texts": {
      "to": [
        "climate.climate_texts"
      ],
      "description": "texts and picture of the climate mod"
    },
    "economy": {
      "to": [
        "climate.economy"
      ],
      "description": "economy of the climate"
    },
    "waterfall": {
      "to": [
        "climate.waterfall"
      ],
      "description": "waterfall brushes of the climate mod"
    },
    "map_name": {
      "to": [
        "map_mods.map_name"
      ],
      "description": "name of the map in the names of its mods"
    },
    "map_mod_texts": {
      "to": [
        "map_mods.map_mod_texts"
      ],
      "description": "titles and mod hub texts of the map's own mods"
    },
    "path_street_mod": {
      "to": [
        "map_mods.path_street_mod"
      ],
      "description": "the mod that builds field tracks and hiking paths as streets"
    },
    "industry_names_mod": {
      "to": [
        "map_mods.industry_names_mod"
      ],
      "description": "the mod that names the industries after the nearest town"
    }
  },
  "nodes": {
    "source_data": {
      "type": "graph:map_source_data"
    },
    "terraforming": {
      "type": "graph:map_terraforming"
    },
    "planning": {
