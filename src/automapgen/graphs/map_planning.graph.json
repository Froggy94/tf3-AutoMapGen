{
  "$schema": "../../../schemas/graph.schema.json",
  "id": "map_planning",
  "title": "Planning",
  "description": "Planned on the draft terrain: field tracks, hiking paths and country roads from OpenStreetMap, towns at OpenStreetMap places with a population on buildable land, and industries on suitable resource areas near the towns. Writes the map editor's import files and previews.",
  "inputs": {
    "draft_planning_landcover": "classes",
    "osm_paths": "osm_lines",
    "places": "osm_points",
    "frame": "map_frame",
    "draft_water": "mask",
    "draft_glacier": "mask",
    "osm_roads": "osm_lines",
    "biome_preview": "image",
    "draft_heightmap": "image",
    "draft_heights": "field",
    "black_m": "number",
    "draft_shore": "mask",
    "draft_rock": "mask",
    "map_format": "map_format",
    "draft_forest": "mask",
    "draft_meadow": "mask",
    "draft_cropland": "mask",
    "mountains": "mask",
    "industry_rules": "industry_rules"
  },
  "outputs": {
    "towns": "town_list",
    "industries": "industry_list",
    "roads": "road_lines",
    "paths": "path_plan"
  },
  "params": {
    "max_towns": {
      "to": [
        "towns.max_towns"
      ],
      "description": "at most this many towns (0 = from the map area)"
    },
    "ignore_town_size": {
      "to": [
        "towns.ignore_town_size",
        "industries.ignore_town_size"
      ],
      "description": "ignore the real town size: all towns start at the minimum and count as equal (industries, roads)"
    },
    "industry_density": {
      "to": [
        "industries.industry_density"
      ],
      "description": "industry density: factories per type, raw-material industries and resource areas x this factor"
    },
    "all_cargos": {
      "to": [
        "industries.all_cargos"
      ],
      "description": "all cargos: resources without fitting land get areas anyway (unrealistic); factories without input source are placed anyway"
    },
    "town_min_distance_game_m": {
      "to": [
        "towns.town_min_distance_game_m"
      ],
      "description": "minimum distance between towns"
    },
    "industries": {
      "to": [
        "industries.industries"
      ],
      "description": "preset: the industry planning of the climate"
    }
  },
  "nodes": {
    "paths_and_roads": {
      "type": "graph:map_planning_lines"
    },
    "towns": {
      "type": "graph:map_planning_towns"
    },
    "industries": {
      "type": "graph:map_planning_industries"
    }
  },
  "links": [
    [
