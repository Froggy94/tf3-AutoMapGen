{
  "$schema": "../../../schemas/graph.schema.json",
  "id": "terrain_core",
  "description": "The terrain chain from heights to layers, without writing anything: water shaping with the river plan, water and shore layers, painted riverbed, OSM fields with crop types, and the class layers (forest, meadow, cropland, rock, glacier) and a preview of the crops leaving water, its border, the riverbed and the fields free. Used twice by a map: as draft for the planners and finally on the settled terrain.",
  "inputs": {
    "heights": "field",
    "landcover": "classes",
    "rivers": "river_plan",
    "land_min_m": "number",
    "map_format": "map_format",
    "farmland": "osm_areas"
  },
  "outputs": {
    "heights": "field",
    "centre": "mask",
    "no_cover": "mask",
    "forest": "mask",
    "meadow": "mask",
    "cropland": "mask",
    "rock": "mask",
    "glacier": "mask",
    "water": "mask",
    "shore": "mask",
    "riverbed": "mask",
    "real": "mask",
    "crop_type": "classes",
    "crops_preview": "image",
    "planning_landcover": "classes"
  },
  "params": {
    "water_sink_m": {"to": ["water.water_sink_m"], "description": "core of real water this much below the lowest land"},
    "real_water_until_m": {"to": ["water.real_water_until_m"], "description": "real (game) water only up to this height"},
    "forest_classes": {"to": ["forest.codes"], "description": "preset: landcover classes of the forest layer"},
    "meadow_classes": {"to": ["meadow.codes"], "description": "preset: landcover classes of the meadow layer"},
    "cropland_classes": {"to": ["wc_cropland.codes"], "description": "preset: WorldCover cropland classes"},
    "rock_classes": {"to": ["rock.codes"], "description": "preset: landcover classes of the rock layer"},
    "crops": {"to": ["fields.crops"], "description": "preset: crop types of the fields"}
  },
  "nodes": {
    "water": {"type": "water.shape"},
    "water_layers": {"type": "water.layers", "params": {"border_game_m": 25}},
    "riverbed": {"type": "riverbed.paint"},
    "forest_clear": {"type": "mask.near", "params": {"distance_px": 4},
                     "note": "no forest 16 game m on each side of the riverbed (the game reads layers coarsely)"},
    "fields": {"type": "farmland.osm_fields"},
    "cut_cover": {"type": "mask.any", "note": "water, its border, the riverbed and the fields stay free of other layers"},
    "cut_forest": {"type": "mask.any"},
    "forest": {"type": "graph:class_mask", "params": {"codes": [10]}},
    "meadow": {"type": "graph:class_mask", "params": {"codes": [20, 30, 50, 90, 100]}},
    "wc_cropland": {"type": "graph:class_mask", "params": {"codes": [40]},
                    "note": "WorldCover cropland without an OSM field becomes meadow"},
    "meadow_all": {"type": "mask.any"},
    "rock": {"type": "graph:class_mask", "params": {"codes": [60]}},
    "glacier": {"type": "graph:class_mask", "params": {"codes": [70]}},
    "cropland": {"type": "mask.subtract", "note": "the OSM fields without the riverbed"},
    "water_texture": {"type": "mask.subtract"},
    "shore_texture": {"type": "mask.subtract"},
    "planning_landcover": {"type": "riverbed.landcover", "note": "landcover as the planners see it"},
    "crops_preview": {"type": "farmland.osm_preview"}
  },
  "links": [
    ["inputs.heights", "water.heights"],
    ["inputs.landcover", "water.landcover"],
    ["inputs.land_min_m", "water.land_min_m"],
    ["inputs.map_format", "water.map_format"],
    ["inputs.rivers", "water.rivers"],
    ["water.core", "water_layers.core"],
    ["water.border", "water_layers.border"],
    ["water.real", "water_layers.real"],
    ["water.beds", "riverbed.beds"],
    ["water_layers.no_cover", "riverbed.no_cover"],
    ["riverbed.bed", "forest_clear.mask"],
    ["inputs.farmland", "fields.areas"],
    ["water_layers.no_cover", "fields.no_cover"],

    ["water_layers.no_cover", "cut_cover.masks"],
    ["riverbed.bed", "cut_cover.masks"],
    ["fields.fields", "cut_cover.masks"],
    ["water_layers.no_cover", "cut_forest.masks"],
    ["forest_clear.mask", "cut_forest.masks"],
    ["fields.fields", "cut_forest.masks"],

    ["water.landcover", "forest.landcover"],
    ["cut_forest.mask", "forest.cut"],
    ["water.landcover", "meadow.landcover"],
    ["cut_cover.mask", "meadow.cut"],
    ["water.landcover", "wc_cropland.landcover"],
    ["cut_cover.mask", "wc_cropland.cut"],
    ["meadow.mask", "meadow_all.masks"],
    ["wc_cropland.mask", "meadow_all.masks"],
    ["water.landcover", "rock.landcover"],
    ["cut_cover.mask", "rock.cut"],
    ["water.landcover", "glacier.landcover"],
    ["cut_cover.mask", "glacier.cut"],
    ["fields.fields", "cropland.mask"],
    ["riverbed.bed", "cropland.minus"],
    ["water_layers.water", "water_texture.mask"],
    ["riverbed.bed", "water_texture.minus"],
    ["water_layers.shore", "shore_texture.mask"],
    ["riverbed.bed", "shore_texture.minus"],
    ["water.landcover", "planning_landcover.landcover"],
    ["riverbed.bed", "planning_landcover.bed"],

    ["water.heights", "outputs.heights"],
    ["riverbed.centre", "outputs.centre"],
    ["water_layers.no_cover", "outputs.no_cover"],
    ["forest.mask", "outputs.forest"],
    ["meadow_all.mask", "outputs.meadow"],
    ["cropland.mask", "outputs.cropland"],
    ["rock.mask", "outputs.rock"],
    ["glacier.mask", "outputs.glacier"],
    ["water_texture.mask", "outputs.water"],
    ["shore_texture.mask", "outputs.shore"],
    ["riverbed.bed", "outputs.riverbed"],
    ["water.real", "outputs.real"],
    ["fields.crop_type", "outputs.crop_type"],
    ["fields.crop_type", "crops_preview.crop_type"],
    ["fields.groups", "crops_preview.groups"],
    ["fields.group_count", "crops_preview.group_count"],
    ["cropland.mask", "crops_preview.cropland"],
    ["crops_preview.preview", "outputs.crops_preview"],
    ["planning_landcover.landcover", "outputs.planning_landcover"]
  ]
}
