{
  "$schema": "../../../schemas/graph.schema.json",
  "id": "climate_mod",
  "description": "The climate mod of a landscape for one reference height and map scale: the base climate's original files, the material and import trees made from the climate preset, the climate definition and generators, the climate tile, the own economy, waterfall brushes and Classic Trees (each optional), and the package with mod hub texts, translations and thumbnail.",
  "inputs": {
    "reference_m": "number",
    "map_format": "map_format"
  },
  "outputs": {
    "mod": "mod_files",
    "mod_id": "text",
    "waterfall_preview": "image"
  },
  "params": {
    "climate": {"to": ["originals.climate", "identity.climate", "material.climate", "imports.climate",
                       "definition.climate", "texts.climate", "classic_trees.climate"],
                "description": "preset: the climate (landscape type)"},
    "transition": {"to": ["identity.transition", "material.transition", "imports.transition",
                          "definition.transition", "texts.transition"],
                   "description": "landscape: a second look on part of the map"},
    "publishing": {"to": ["identity.publishing", "pictures.publishing", "texts.publishing", "package.publishing"],
                   "description": "names, author and images of the published mods"},
    "climate_texts": {"to": ["identity.climate_texts", "pictures.climate_texts", "texts.climate_texts"],
                      "description": "texts and picture of the climate mod"},
    "economy": {"to": ["economy.economy", "texts.economy"], "description": "economy of the climate"},
    "industries": {"to": ["economy.industries"],
                   "description": "preset: the industry planning (industries and cargos of other climates)"},
    "waterfall": {"to": ["waterfall.waterfall"], "description": "waterfall brushes of the climate mod"}
  },
  "nodes": {
    "originals": {"type": "climate.originals", "note": "game files of the base climate"},
    "identity": {"type": "climate.identity"},
    "material": {"type": "climate.material_tree"},
    "imports": {"type": "climate.import_tree"},
    "economy": {"type": "climate.economy"},
    "definition": {"type": "climate.definition"},
    "generators": {"type": "climate.generators"},
    "pictures": {"type": "climate.pictures"},
    "files": {"type": "climate.files"},
    "waterfall": {"type": "climate.waterfall"},
    "classic_trees": {"type": "climate.classic_trees"},
    "texts": {"type": "climate.mod_texts"},
    "package": {"type": "mod.package"}
  },
  "links": [
    ["inputs.reference_m", "identity.reference_m"],
    ["inputs.map_format", "identity.map_format"],
    ["originals.material_tree", "material.original"],
    ["inputs.reference_m", "material.reference_m"],
    ["inputs.map_format", "material.map_format"],
    ["identity.mod_id", "material.mod_id"],
    ["originals.import_tree", "imports.original"],
    ["inputs.reference_m", "imports.reference_m"],
    ["inputs.map_format", "imports.map_format"],
    ["originals.clima", "economy.clima"],
    ["identity.identity", "economy.identity"],
    ["originals.clima", "definition.clima"],
    ["economy.path", "definition.economy_path"],
    ["identity.identity", "definition.identity"],
    ["inputs.reference_m", "definition.reference_m"],
    ["inputs.map_format", "definition.map_format"],
    ["originals.import_generator", "generators.import_generator"],
    ["originals.random_generator", "generators.random_generator"],
    ["identity.identity", "generators.identity"],
    ["identity.stamp", "pictures.stamp"],
    ["identity.identity", "files.identity"],
    ["material.tree", "files.material_tree"],
    ["imports.tree", "files.import_tree"],
    ["definition.clima", "files.clima"],
    ["generators.import_generator", "files.import_generator"],
    ["generators.random_generator", "files.random_generator"],
    ["pictures.icon", "files.icon"],
    ["inputs.reference_m", "texts.reference_m"],
    ["inputs.map_format", "texts.map_format"],
    ["identity.mod_id", "classic_trees.mod_id"],
    ["files.files", "package.content"],
    ["economy.files", "package.content"],
    ["waterfall.files", "package.content"],
    ["classic_trees.files", "package.content"],
    ["classic_trees.post_run_script", "package.post_run_script"],
    ["identity.mod_id", "package.mod_id"],
    ["texts.info", "package.info"],
    ["texts.translations", "package.translations"],
    ["pictures.thumbnail", "package.thumbnail"],
    ["package.mod", "outputs.mod"],
    ["identity.mod_id", "outputs.mod_id"],
    ["waterfall.preview", "outputs.waterfall_preview"]
  ]
}
